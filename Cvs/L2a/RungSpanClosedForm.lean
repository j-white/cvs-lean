  have hs₂ : 0 < s₂ := sqrt_pos.mpr (div_pos hτ₂ hden2)
  have hs₂sq : s₂ ^ 2 = τ 2 / (2 * (1 + ρ₁)) := sq_sqrt (div_pos hτ₂ hden2).le
  have key : (s₂ * (1 + ρ₁) + τ 2 / (2 * s₂)) / 2 = √((1 + ρ₁) * τ 2 / 2) := by
    have hr : 0 ≤ (1 + ρ₁) * τ 2 / 2 := by positivity
    rw [← Real.sqrt_sq (show 0 ≤ (s₂ * (1 + ρ₁) + τ 2 / (2 * s₂)) / 2 by positivity)]
